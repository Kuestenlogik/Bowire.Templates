<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Bowire.Plugin1</PackageId>
    <Description>Bowire protocol plugin for MY_PROTOCOL_DISPLAY_NAME.</Description>
    <PackageTags>bowire bowire-plugin MY_PROTOCOL_ID</PackageTags>
    <PackageType>BowirePlugin</PackageType>
    <IsPackable>true</IsPackable>
    <!--#if (ProjectOnly || Minimal) -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Kuestenlogik.Bowire" />
    <!--#if (Preset == "mqtt") -->
    <PackageReference Include="MQTTnet" />
    <!--#endif -->
    <!--#if (Preset == "grpc") -->
    <PackageReference Include="Grpc.Net.Client" />
    <!--#endif -->
    <!--#if (Preset == "signalr") -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!--#endif -->
  </ItemGroup>

  <!-- Versions for the ProjectOnly / Minimal output, which has no
       Directory.Packages.props of its own. Where central package
       management is on, Directory.Packages.props is the single source
       and this group evaluates away. Stating it as an MSBuild condition
       rather than a template conditional is also what keeps this file
       restorable as template source, where every branch is present at
       once and two Includes of one package are NU1504.

       The Bowire version is the template parameter, not a literal. A
       literal here was a second place to keep current, and it was not
       kept: the ProjectOnly output ignored BowireSdkVersion and pinned
       whatever the last cascade had written. The cascade reaches this
       through the parameter instead. It bumps the symbol whose
       `replaces` token Directory.Packages.props carries, and its sed
       declines to touch a Version that does not start with a digit. -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Update="Kuestenlogik.Bowire" Version="MY_BOWIRE_VERSION" />
    <!--#if (Preset == "mqtt") -->
    <PackageReference Update="MQTTnet" Version="5.1.0.1559" />
    <!--#endif -->
    <!--#if (Preset == "grpc") -->
    <PackageReference Update="Grpc.Net.Client" Version="2.80.0" />
    <!--#endif -->
    <!--#if (Preset == "signalr") -->
    <PackageReference Update="Microsoft.AspNetCore.SignalR.Client" Version="10.0.7" />
    <!--#endif -->
  </ItemGroup>

</Project>
