<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow MY_BOWIRE_VERSION (the BowireSdkVersion template
         parameter, whose default is declared once, in
         .template.config/template.json) to be either a fixed pin or
         a floating range like "2.6.*". Without this, CPM rejects any
         version containing '*' with NU1011. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Kuestenlogik.Bowire" Version="MY_BOWIRE_VERSION" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!--#if (IncludeIntegrationTests) -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.7" />
    <!--#endif -->
    <!--#if (Preset == "mqtt") -->
    <PackageVersion Include="MQTTnet" Version="5.1.0.1559" />
    <!--#endif -->
    <!--#if (Preset == "grpc") -->
    <PackageVersion Include="Grpc.Net.Client" Version="2.80.0" />
    <!--#endif -->
    <!--#if (Preset == "signalr") -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.7" />
    <!--#endif -->
  </ItemGroup>
</Project>
